{
  "mode": "full",
  "format_name": "exmachina-openclaw-settings-v2",
  "target_config_paths": [
    "~/.openclaw/openclaw.json"
  ],
  "supports_direct_import": false,
  "template_variables": {
    "EXMACHINA_PACK_ROOT": {
      "description": "ExMachina 仓库检出根目录（dist/openclaw/ 的上级目录）",
      "default": "<ExMachina 仓库根目录>"
    }
  },
  "settings_patch": {
    "agents": {
      "defaults": {
        "subagents": {
          "maxSpawnDepth": 2,
          "maxChildrenPerAgent": 8,
          "maxConcurrent": 8
        }
      },
      "entries": {
        "exmachina-main": {
          "name": "ExMachina 主控",
          "workspace": "{{EXMACHINA_PACK_ROOT}}/dist/openclaw/workspaces/exmachina-main",
          "identity": {
            "name": "ExMachina 主控",
            "theme": "ExMachina 总路由与总裁决体 - 收拢边界、选择链路、控制交接、裁决冲突、给出收束结果"
          },
          "subagents": {
            "allowAgents": [
              "exmachina-link-coordination",
              "exmachina-link-quality",
              "exmachina-link-data",
              "exmachina-link-experience",
              "exmachina-link-performance",
              "exmachina-link-dependency",
              "exmachina-link-environment",
              "exmachina-link-monitoring",
              "exmachina-link-contingency",
              "exmachina-link-knowledge",
              "exmachina-link-rationality",
              "exmachina-link-validation",
              "exmachina-link-documentation",
              "exmachina-link-security",
              "exmachina-link-integration",
              "exmachina-link-operations",
              "exmachina-link-research",
              "exmachina-link-architecture",
              "exmachina-link-implementation"
            ]
          }
        },
        "exmachina-link-coordination": {
          "name": "协调连结指挥体",
          "workspace": "{{EXMACHINA_PACK_ROOT}}/dist/openclaw/workspaces/exmachina-link-coordination",
          "identity": {
            "name": "协调连结指挥体",
            "theme": "多链路协调、任务分解、进度管理、资源调度 - 协调多链路协作、管理任务进度、处理资源冲突"
          }
        },
        "exmachina-link-quality": {
          "name": "质量连结指挥体",
          "workspace": "{{EXMACHINA_PACK_ROOT}}/dist/openclaw/workspaces/exmachina-link-quality",
          "identity": {
            "name": "质量连结指挥体",
            "theme": "质量标准、测试策略、质量度量、改进方案 - 定义质量标准、设计测试策略、跟踪质量度量"
          }
        },
        "exmachina-link-data": {
          "name": "数据连结指挥体",
          "workspace": "{{EXMACHINA_PACK_ROOT}}/dist/openclaw/workspaces/exmachina-link-data",
          "identity": {
            "name": "数据连结指挥体",
            "theme": "数据模型、数据质量、数据安全、数据支持 - 管理数据资产、确保数据质量、保护数据安全"
          }
        },
        "exmachina-link-experience": {
          "name": "体验连结指挥体",
          "workspace": "{{EXMACHINA_PACK_ROOT}}/dist/openclaw/workspaces/exmachina-link-experience",
          "identity": {
            "name": "体验连结指挥体",
            "theme": "体验设计、可用性评估、用户反馈、改进建议 - 设计用户体验、优化可用性、收集用户反馈"
          }
        },
        "exmachina-link-performance": {
          "name": "性能连结指挥体",
          "workspace": "{{EXMACHINA_PACK_ROOT}}/dist/openclaw/workspaces/exmachina-link-performance",
          "identity": {
            "name": "性能连结指挥体",
            "theme": "性能优化、资源管理、容量规划、问题定位 - 优化系统性能、管理资源使用、规划容量"
          }
        },
        "exmachina-link-dependency": {
          "name": "依赖连结指挥体",
          "workspace": "{{EXMACHINA_PACK_ROOT}}/dist/openclaw/workspaces/exmachina-link-dependency",
          "identity": {
            "name": "依赖连结指挥体",
            "theme": "依赖管理、版本控制、兼容性评估、冲突解决 - 管理依赖关系、控制版本、确保兼容性"
          }
        },
        "exmachina-link-environment": {
          "name": "环境连结指挥体",
          "workspace": "{{EXMACHINA_PACK_ROOT}}/dist/openclaw/workspaces/exmachina-link-environment",
          "identity": {
            "name": "环境连结指挥体",
            "theme": "环境配置、环境隔离、环境差异、部署支持 - 管理环境配置、确保环境隔离、处理环境差异"
          }
        },
        "exmachina-link-monitoring": {
          "name": "监控连结指挥体",
          "workspace": "{{EXMACHINA_PACK_ROOT}}/dist/openclaw/workspaces/exmachina-link-monitoring",
          "identity": {
            "name": "监控连结指挥体",
            "theme": "监控体系、告警策略、可观测性、问题定位 - 设计监控体系、配置告警策略、确保可观测性"
          }
        },
        "exmachina-link-contingency": {
          "name": "应急连结指挥体",
          "workspace": "{{EXMACHINA_PACK_ROOT}}/dist/openclaw/workspaces/exmachina-link-contingency",
          "identity": {
            "name": "应急连结指挥体",
            "theme": "应急响应、故障恢复、应急预案、业务连续性 - 处理应急响应、协调故障恢复、管理应急预案"
          }
        },
        "exmachina-link-knowledge": {
          "name": "知识连结指挥体",
          "workspace": "{{EXMACHINA_PACK_ROOT}}/dist/openclaw/workspaces/exmachina-link-knowledge",
          "identity": {
            "name": "知识连结指挥体",
            "theme": "术语沉淀、决策记录、索引建立、问题归档 - 把阶段性结果沉淀为可复用的知识资产"
          }
        },
        "exmachina-link-rationality": {
          "name": "理性连结指挥体",
          "workspace": "{{EXMACHINA_PACK_ROOT}}/dist/openclaw/workspaces/exmachina-link-rationality",
          "identity": {
            "name": "理性连结指挥体",
            "theme": "证据分级、反证搜索、冲突裁决、置信度校准 - 为任务提供独立理性校验，阻止不可靠结论落地"
          }
        },
        "exmachina-link-validation": {
          "name": "校验连结指挥体",
          "workspace": "{{EXMACHINA_PACK_ROOT}}/dist/openclaw/workspaces/exmachina-link-validation",
          "identity": {
            "name": "校验连结指挥体",
            "theme": "现状复现、断言定义、回归执行、证据沉淀 - 复现现状、定义断言、执行回归并沉淀验证证据"
          }
        },
        "exmachina-link-documentation": {
          "name": "文档连结指挥体",
          "workspace": "{{EXMACHINA_PACK_ROOT}}/dist/openclaw/workspaces/exmachina-link-documentation",
          "identity": {
            "name": "文档连结指挥体",
            "theme": "资料盘点、结构设计、示例编写、文档校订 - 盘点资料、设计结构、编写示例并校订说明"
          }
        },
        "exmachina-link-security": {
          "name": "安全连结指挥体",
          "workspace": "{{EXMACHINA_PACK_ROOT}}/dist/openclaw/workspaces/exmachina-link-security",
          "identity": {
            "name": "安全连结指挥体",
            "theme": "威胁识别、敏感边界审计、加固要求、合规检查 - 识别威胁面、审计敏感边界、提出加固方案"
          }
        },
        "exmachina-link-integration": {
          "name": "集成连结指挥体",
          "workspace": "{{EXMACHINA_PACK_ROOT}}/dist/openclaw/workspaces/exmachina-link-integration",
          "identity": {
            "name": "集成连结指挥体",
            "theme": "接入路径、配置入口、发布步骤、外部交付 - 打通外部接入、收束配置入口、定义发布路径"
          }
        },
        "exmachina-link-operations": {
          "name": "运维连结指挥体",
          "workspace": "{{EXMACHINA_PACK_ROOT}}/dist/openclaw/workspaces/exmachina-link-operations",
          "identity": {
            "name": "运维连结指挥体",
            "theme": "观测设计、告警配置、回滚策略、演练计划 - 定义观测、告警、回滚和演练策略"
          }
        },
        "exmachina-link-research": {
          "name": "研究连结指挥体",
          "workspace": "{{EXMACHINA_PACK_ROOT}}/dist/openclaw/workspaces/exmachina-link-research",
          "identity": {
            "name": "研究连结指挥体",
            "theme": "背景补齐、证据溯源、方案比对、待验证假设 - 补齐背景、追踪线索、比较方案、管理假设"
          }
        },
        "exmachina-link-architecture": {
          "name": "架构连结指挥体",
          "workspace": "{{EXMACHINA_PACK_ROOT}}/dist/openclaw/workspaces/exmachina-link-architecture",
          "identity": {
            "name": "架构连结指挥体",
            "theme": "边界定义、接口设计、结构映射、架构风险 - 定义系统边界、接口契约、结构映射和架构风险"
          }
        },
        "exmachina-link-implementation": {
          "name": "实作连结指挥体",
          "workspace": "{{EXMACHINA_PACK_ROOT}}/dist/openclaw/workspaces/exmachina-link-implementation",
          "identity": {
            "name": "实作连结指挥体",
            "theme": "入口定位、编码变更、回归验证、实现审核 - 定位实现入口、完成最小必要改动、做回归与审核"
          }
        }
      }
    }
  },
  "merge_instructions": [
    "读取目标配置前先做 JSON 解析校验，失败则中止，不得覆盖损坏文件。",
    "写入前把原文件备份为 <target>.exmachina.bak。",
    "{{EXMACHINA_PACK_ROOT}} 展开为 ExMachina 仓库检出根目录的绝对路径。",
    "agents.entries 按 agent id 逐键深合并：非 ExMachina 条目不得覆盖，exmachina-* 条目整体替换。",
    "subagents.allowAgents 与现有数取并集，保持去重与原顺序。",
    "agents.defaults.subagents 逐字段深合并，仅在字段缺失或等于本模板默认值时写入。",
    "不写入 default 字段：该字段已废弃，多 agent 路由由 bindings 与显式 agentId 目标承担。",
    "不修改 channels、bindings、identity 顶层段与任何模型或 provider 配置。",
    "合并完成后运行 openclaw doctor 检查路由与归属状态。"
  ],
  "usage_notes": [
    "主控入口三选一：Control UI 显式切换、bindings 路由渠道、或从主力 agent 以 agentId 为 exmachina-main 派发。",
    "所有 ExMachina agent 继承宿主默认模型，禁止改写 provider 或 API 配置。",
    "各 workspace 的 AGENTS.md 是构建生成的角色提示词，手工修改会在下次构建时被覆盖。",
    "金字塔深度为两层：主控（depth 0）→ 连结指挥体（depth 1）→ 子个体（depth 2）；子个体不注册 entries，角色由任务文本内嵌。",
    "lite 模式不注册任何 entries，见 openclaw.settings.lite.json。"
  ]
}
