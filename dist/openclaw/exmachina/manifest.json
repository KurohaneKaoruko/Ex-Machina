    "selection_rule": "默认选择一个连结体独立完成任务；若需要并行推进，说明平级分工与交付边界。",
    "quick_start": [
      "读取 manifest.json 确认模式、连结体清单与选择规则。",
      "读取 protocol/ 下的协议文件，再读取 agents/00_全连结指挥体.md。",
      "读取 runtime/topology.json 与 runtime/task-board.json，按多智能体任务板推进。",
      "主控体选择当前执行连结体并汇总回流结果。"
    ],
    "do_not_assume": [
      "不要在未启用子代理（subagents / sessions_spawn）时启动任务。",
      "不要跳过任务板与路由回流。"
    ]
  }
